# Porta HTTP exposta no host quando usar Docker Compose.
SERVERWATCH_PORT=3000

# Variaveis usadas diretamente pela aplicacao.
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data

# Persistencia: json (padrao) ou mongodb.
SERVERWATCH_STORAGE=json
MONGODB_URI=mongodb://serverwatch:TROQUE_ESSA_SENHA@127.0.0.1:27017/serverwatch?authSource=admin
MONGODB_DB=serverwatch

# Usuario administrador criado automaticamente quando ainda nao houver usuarios.
SERVERWATCH_ADMIN_EMAIL=admin@serverwatch.local
SERVERWATCH_ADMIN_PASSWORD=admin123
