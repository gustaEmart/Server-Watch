# Porta HTTP exposta no host quando usar Docker Compose.
SERVERWATCH_PORT=3000

# Variaveis usadas diretamente pela aplicacao.
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data

# Persistencia: use mongodb para deploy novo em Docker.
SERVERWATCH_STORAGE=mongodb
MONGODB_URI=mongodb://serverwatch:troque-essa-senha@mongodb:27017/serverwatch?authSource=admin
MONGODB_DB=serverwatch

# Credenciais do container MongoDB.
MONGO_INITDB_ROOT_USERNAME=serverwatch
MONGO_INITDB_ROOT_PASSWORD=troque-essa-senha

# Usuario administrador criado automaticamente quando ainda nao houver usuarios.
SERVERWATCH_ADMIN_EMAIL=admin@serverwatch.local
SERVERWATCH_ADMIN_PASSWORD=admin123

# Token global usado pelos instaladores do Probe Collector.
# Gere um valor forte antes de expor o sistema fora da rede local.
SERVERWATCH_PROBE_TOKEN=

# API key do provedor de Cloud Backup MSP. Sem ela, a integracao fica desativada.
CLOUDBACKUP_API_KEY=

# Proxmox Backup Server (PBS) somente leitura, para monitoramento de backups Proxmox.
PROXMOX_PBS_BASE_URL=
PROXMOX_PBS_TOKEN_ID=
PROXMOX_PBS_TOKEN_SECRET=
PROXMOX_PBS_TLS_FINGERPRINT=

# UniFi Network API oficial local.
UNIFI_BASE_URL=
UNIFI_API_KEY=
UNIFI_TLS_FINGERPRINT=
UNIFI_API_BASE_PATH=/proxy/network/integration
