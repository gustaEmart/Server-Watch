{
  "schemaVersion": 1,
  "id": "host-resources",
  "name": "Host resources",
  "description": "Standard HOST-RESOURCES-MIB metrics for servers: uptime, CPU load and storage table.",
  "targetTypes": ["linux", "windows", "generic-server"],
  "metrics": [
    {
      "key": "host.uptime",
      "name": "Host resources uptime",
      "kind": "scalar",
      "oid": "1.3.6.1.2.1.25.1.1.0",
      "mib": "HOST-RESOURCES-MIB::hrSystemUptime.0",
      "valueType": "timeticks",
      "unit": "timeticks",
      "history": true
    },
    {
      "key": "cpu.processor_load",
      "name": "Processor load",
      "kind": "table",
      "oid": "1.3.6.1.2.1.25.3.3.1.2",
      "mib": "HOST-RESOURCES-MIB::hrProcessorLoad",
      "valueType": "integer",
      "unit": "percent",
      "history": true,
      "aggregation": "average"
    },
    {
      "key": "storage.index",
      "name": "Storage index",
      "kind": "table",
      "oid": "1.3.6.1.2.1.25.2.3.1.1",
      "mib": "HOST-RESOURCES-MIB::hrStorageIndex",
      "valueType": "integer",
      "unit": null,
      "history": false
    },
    {
      "key": "storage.type",
      "name": "Storage type",
      "kind": "table",
      "oid": "1.3.6.1.2.1.25.2.3.1.2",
      "mib": "HOST-RESOURCES-MIB::hrStorageType",
      "valueType": "string",
      "unit": null,
      "history": false
    },
    {
      "key": "storage.description",
      "name": "Storage description",
      "kind": "table",
      "oid": "1.3.6.1.2.1.25.2.3.1.3",
      "mib": "HOST-RESOURCES-MIB::hrStorageDescr",
      "valueType": "string",
      "unit": null,
      "history": false
    },
    {
      "key": "storage.allocation_units",
      "name": "Storage allocation units",
      "kind": "table",
      "oid": "1.3.6.1.2.1.25.2.3.1.4",
      "mib": "HOST-RESOURCES-MIB::hrStorageAllocationUnits",
      "valueType": "integer",
      "unit": "bytes",
      "history": false
    },
    {
      "key": "storage.size",
      "name": "Storage size",
      "kind": "table",
      "oid": "1.3.6.1.2.1.25.2.3.1.5",
      "mib": "HOST-RESOURCES-MIB::hrStorageSize",
      "valueType": "integer",
      "unit": "allocation_units",
      "history": false
    },
    {
      "key": "storage.used",
      "name": "Storage used",
      "kind": "table",
      "oid": "1.3.6.1.2.1.25.2.3.1.6",
      "mib": "HOST-RESOURCES-MIB::hrStorageUsed",
      "valueType": "integer",
      "unit": "allocation_units",
      "history": true,
      "computedMetrics": ["storage.used_percent", "storage.used_bytes"]
    }
  ]
}
